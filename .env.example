# 357Network local/deployment environment template.
# Copy to .env for local development or configure the same names in the production host.
# Never commit real secret values.

# Browser/client Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI preparation (server-only)
OPENAI_API_KEY=
# Optional; defaults to gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# Job discovery (server-only).
# Optional: the public fallback source works without these values.
# Configure Adzuna for broader multi-source coverage.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Browser automation (server-only)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Final submit safety gate.
# Keep false until a controlled end-to-end submission test has been approved and passed.
AUTOMATION_ENABLE_SUBMIT=false
