# 357Network local/deployment environment template.
# Copy to .env for local development or configure the same names in the production host.
# Never commit real secret values.

# Browser/client Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public application URL used for Stripe success/cancel/portal return URLs.
PUBLIC_APP_URL=

# Stripe billing (server-only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AUTO=

# AI preparation (server-only)
OPENAI_API_KEY=
# Optional; defaults to gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# Job discovery (server-only).
# Optional: the public fallback source works without these values.
# Configure Adzuna for broader multi-source coverage.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Browser automation (server-only).
# Current Browserbase API keys are project-scoped, so BROWSERBASE_PROJECT_ID is optional.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Optional dedicated model key for Stagehand. If omitted, OPENAI_API_KEY is reused.
MODEL_API_KEY=
# Optional Stagehand model override; defaults to openai/gpt-5.4-mini.
STAGEHAND_MODEL=openai/gpt-5.4-mini

# Final submit safety gate.
# Keep false until a controlled end-to-end submission test has been approved and passed.
AUTOMATION_ENABLE_SUBMIT=false
